# Copia este archivo como .env (no se sube a git) y pon tu clave de Groq.
# Se crea gratis en https://console.groq.com/keys
GROQ_API_KEY=

# Voz natural de Orbi (Gemini TTS). Clave en https://aistudio.google.com/apikey
# Sin ella, la app usa la voz local Piper.
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# GEMINI_TTS_VOICE=Sulafat

# Opcional: modelos de Groq (su catálogo cambia; consulta /openai/v1/models).
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Sincronización con Horion Web (HORIO_WEB). Sin estas dos variables no se envía nada.
# URL del backend Django (no la de Vercel), sin barra final.
# HORION_CLOUD_URL=https://horion-api.onrender.com
# Debe coincidir con EDGE_API_KEY del backend Django.
# EDGE_API_KEY=
# Segundos entre envíos (mínimo 5).
# HORION_SYNC_INTERVAL=30
